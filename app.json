{
  "expo": {
    "name": "PointHunters",
    "slug": "pointhunters",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "package": "com.my.app",
        "permissions": ["REQUEST_INSTALL_PACKAGES"]
      },
      "package": "com.ipiotrs.PointHunters"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f7846102-3713-46ed-a108-890c5f150e44"
      }
    }
  }
}
